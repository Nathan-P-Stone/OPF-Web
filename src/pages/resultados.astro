---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { createClient } from "@supabase/supabase-js";
import Tarjeta from "../components/Tarjeta.astro";
import Seccion from "../components/Seccion.astro";
import Oro from "../assets/medallas/OPFOro.png";
import Plata from "../assets/medallas/OPFPlata.png";
import Bronce from "../assets/medallas/OPFBronce.png";

// CAMBIAR A TRUE PARA PUBLICAR RESULTADOS
const resultadosPublicados = true;

interface Participante {
  nombre: string;
  escuela: string;
  cal: number;
}

let podiog: any[] = [];
let GRes: any[] = [];
const Medallas = [Oro, Plata, Bronce];
const NPodio = ["1er Lugar", "2do Lugar", "3er Lugar"];
const Color = ["dorado", "gris", "naranja"];

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

if (resultadosPublicados) {
  const { data: RawCal, error } = await supabase
    .from("OPF Resultados")
    .select("nombre, escuela, cal");

  if (error) {
    console.error("Error al obtener datos de Supabase:", error);
  }

  if (RawCal) {
    const ParticipantesOrdenados = [...RawCal].sort(
      (a: Participante, b: Participante) => b.cal - a.cal,
    );

    podiog = ParticipantesOrdenados.slice(0, 3).map(
      (participante: Participante, index: number) => ({
        puesto: NPodio[index],
        posicion: index,
        color: Color[index],
        nombre: participante.nombre,
        escuela: participante.escuela,
        medalla: Medallas[index],
      }),
    );

    // Ordenar el podio por tradicion 2,1,3
    const ordenVisual = [1, 0, 2].filter((i) => podiog[i]);
    podiog = ordenVisual.map((i) => podiog[i]);

    GRes = ParticipantesOrdenados.slice(3).map((participante, index) => ({
      posicion: index + 4,
      nombre: participante.nombre,
      escuela: participante.escuela,
    }));
  }
}
---

<Layout>
  <main>
    {
      resultadosPublicados ? (
        <>
          <Seccion titulo="Resultados del Segundo Selectivo" acento="azulUaslp">
            <p>
              Felicitamos a todas y todos los participantes del Segundo
              Selectivo por su dedicación y entusiasmo. Su esfuerzo refleja una
              verdadera pasión por el conocimiento y la ciencia.
            </p>
            <strong>Conoce a los perfiles destacados de esta edición.</strong>
          </Seccion>

          <h1>Podio</h1>

          <section class="podio">
            {podiog.map((participante) => (
              <div class={`podio-item puesto-${participante.posicion + 1}`}>
                <Tarjeta
                  hover={true}
                  acento={participante.color}
                  colorTitulo={participante.color == "gris" ? "negro" : "blanco"}
                  titulo={participante.puesto}
                >
                  <div class="puesto-contenido">
                    <div class="medalla">
                      <Image
                        src={participante.medalla}
                        alt={`Medalla de ${participante.puesto}`}
                      />
                    </div>
                    <h2>{participante.nombre}</h2>
                    <p class="escuela">{participante.escuela}</p>
                  </div>
                </Tarjeta>
              </div>
            ))}
          </section>

          <section class="seccion-tabla">
            <h1>Tabla General de Posiciones</h1>

            <div class="tabla-responsiva">
              <table class="tabla-resultados">
                <thead>
                  <tr>
                    <th>Posición</th>
                    <th>Nombre</th>
                    <th>Escuela</th>
                  </tr>
                </thead>
                <tbody>
                  {GRes.map((alumno) => (
                    <tr>
                      <td>
                        <strong>{alumno.posicion}</strong>
                      </td>
                      <td>{alumno.nombre}</td>
                      <td>{alumno.escuela}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </>
      ) : (
        /* --- VISTA DE ESPERA (Si es FALSE) --- */
        <Tarjeta titulo="¡Proximamante!" acento="azulUaslp">
          <div class="icono-espera">⏳</div>
          <p class="texto-espera">
            Estamos afinando los últimos detalles y calculando los puntajes.
            Vuelve pronto para conocer a los ganadores de esta edición.
          </p>
        </Tarjeta>
      )
    }
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .podio {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .puesto-1 {
    width: 200px;
  }

  .puesto-2 {
    width: 200px;
  }

  .puesto-3 {
    width: 200px;
  }

  .puesto-contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .escuela {
    color: var(--grisOscuro);
    font-weight: bold;
    margin-top: 0.5rem;
  }

  .puesto-texto {
    color: var(--dorado);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .medalla {
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
  }

  .medalla img {
    width: 80px;
    height: auto;
  }

  .seccion-tabla {
    text-align: left;
    margin-top: 4rem;
  }

  h1 {
    font-size: 2rem;
    color: var(--negro);
    margin-bottom: 2rem;
    text-align: center;
  }

  .tabla-responsiva {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--gris);
    background: #fff;
  }

  .tabla-resultados {
    width: 100%;
    border-collapse: collapse;
  }

  .tabla-resultados th,
  .tabla-resultados td {
    padding: 1.2rem;
    border-bottom: 1px solid var(--gris);
  }

  .tabla-resultados th {
    background-color: var(--verde);
    color: #fff;
    text-align: left;
  }

  .tabla-resultados tbody tr:hover {
    background-color: var(--crema);
  }

  .proximamente {
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5rem 2rem;
  }

  .icono-espera {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .titulo-espera {
    color: var(--negro);
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .texto-espera {
    font-size: 1.2rem;
    line-height: 1.6;
  }
  /* Ajustes para moviles que se veía qlero */
  @media (max-width: 768px) {
    .titulo {
      font-size: 2.2rem;
    }

    p {
      font-size: 1rem;
    }

    .podio {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .podio > * {
      width: 100%;
      max-width: 320px;
    }

    .podio-item.puesto-1 {
      order: 1;
    }

    .podio-item.puesto-2 {
      order: 2;
    }

    .podio-item.puesto-3 {
      order: 3;
    }

    .subtitulo-tabla {
      font-size: 1.5rem;
    }

    .tabla-resultados th,
    .tabla-resultados td {
      padding: 0.8rem;
      font-size: 0.9rem;
    }
  }
</style>
