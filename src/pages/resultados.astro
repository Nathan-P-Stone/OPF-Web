---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { createClient } from "@supabase/supabase-js";
import Tarjeta from "../components/Tarjeta.astro";
import Seccion from "../components/Seccion.astro";
import Oro from "../assets/medallas/OPFOro.png";
import Plata from "../assets/medallas/OPFPlata.png";
import Bronce from "../assets/medallas/OPFBronce.png";

// CAMBIAR A TRUE PARA PUBLICAR RESULTADOS
const resultadosPublicados = true;

interface Participante {
  nombre: string;
  escuela: string;
  cal: number;
}

let podiog: any[] = [];
let GRes: any[] = [];
const Medallas = [Oro, Plata, Bronce];
const NPodio = ["1er Lugar", "2do Lugar", "3er Lugar"];
const Color = ["oro", "plata", "bronce"];

const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseKey = import.meta.env.SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

if (resultadosPublicados) {
  const { data: RawCal, error } = await supabase
    .from("OPF Resultados")
    .select("nombre, escuela, cal");

  if (error) {
    console.error("Error al obtener datos de Supabase:", error);
  }

  if (RawCal) {
    const ParticipantesOrdenados = [...RawCal].sort(
      (a: Participante, b: Participante) => b.cal - a.cal,
    );

    podiog = ParticipantesOrdenados.slice(0, 3).map(
      (participante: Participante, index: number) => ({
        puesto: NPodio[index],
        posicion: index,
        color: Color[index],
        nombre: participante.nombre,
        escuela: participante.escuela,
        medalla: Medallas[index],
      }),
    );

    // Ordenar el podio por tradicion 2,1,3
    const ordenVisual = [1, 0, 2].filter((i) => podiog[i]);
    podiog = ordenVisual.map((i) => podiog[i]);

    GRes = ParticipantesOrdenados.slice(3).map((participante, index) => ({
      posicion: index + 4,
      nombre: participante.nombre,
      escuela: participante.escuela,
    }));
  }
}
---

<Layout>
  <main>
    {
      resultadosPublicados ? (
        <>
          <Seccion titulo="Resultados del Segundo Selectivo" acento="azulUaslp">
            <p>
              Felicitamos a todas y todos los participantes del Segundo
              Selectivo por su dedicación y entusiasmo. Su esfuerzo refleja una
              verdadera pasión por el conocimiento y la ciencia.
            </p>
            <strong>Conoce a los perfiles destacados de esta edición.</strong>
          </Seccion>

          <h1 class="titulo-podio">Podio</h1>

          <div class="escenario-podio">
            <section class="podio">
              {podiog.map((participante) => (
                <div
                  class={`columna-podio puesto-${participante.posicion + 1}`}
                >
                  <div class={`pilar-fondo pilar-${participante.color}`} />
                  <div class="info-ganador">
                    <Image
                      src={participante.medalla}
                      alt={`medalla de ${participante.puesto}`}
                      class="img-medalla"
                    />
                    <h2 class="nombre-ganador">{participante.nombre}</h2>
                    <p class="escuela-ganador">{participante.escuela}</p>
                    <span class="etiqueta-puesto">{participante.puesto}</span>
                  </div>
                </div>
              ))}
            </section>

            <section class="seccion-tabla">
              <h2>Tabla General de Posiciones</h2>

              <div class="tabla-responsiva">
                <table class="tabla-resultados">
                  <thead>
                    <tr>
                      <th>Posición</th>
                      <th>Nombre</th>
                      <th>Escuela</th>
                    </tr>
                  </thead>
                  <tbody>
                    {GRes.map((alumno) => (
                      <tr>
                        <td>
                          <strong>{alumno.posicion}</strong>
                        </td>
                        <td>{alumno.nombre}</td>
                        <td>{alumno.escuela}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          </div>
        </>
      ) : (
        /* --- VISTA DE ESPERA (Si es FALSE) --- */
        <Tarjeta titulo="¡Proximamante!" acento="azulUaslp">
          <div class="icono-espera">⏳</div>
          <p class="texto-espera">
            Estamos afinando los últimos detalles y calculando los puntajes.
            Vuelve pronto para conocer a los ganadores de esta edición.
          </p>
        </Tarjeta>
      )
    }
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  .titulo-podio {
    font-size: 2rem;
    color: var(--negro);
    margin-bottom: 2rem;
    text-align: center;
  }

  /* DISEÑO ACÁ CABRÓN DEL PODIO */
  /* El z-index es para separar capas pijes */
  .escenario-podio {
    position: relative;
    overflow: hidden;
    padding-bottom: 2rem;
  }

  .podio {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }

  .columna-podio {
    position: relative;
    width: 32%;
    max-width: 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pilar-fondo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1000px;
    border-radius: 60px 60px 0 0;
    z-index: 1;
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 40%,
      transparent 60%
    );
    box-shadow:
      inset 0 4px 15px rgba(255, 255, 255, 0.4),
      0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .pilar-oro {
    background: linear-gradient(135deg, #ffd700, #fdb931);
  }

  .pilar-plata {
    background: linear-gradient(135deg, #e0e0e0, #9e9e9e);
  }

  .pilar-bronce {
    background: linear-gradient(135deg, #fb995d, #c6704e);
  }

  /* CONSIDEREN HACER UN NUEVO COMPONENTE CON ESTO */
  .info-ganador {
    position: relative;
    z-index: 2;
    padding: 2rem 2rem;
    text-align: center;
    width: 100%;
  }

  .img-medalla {
    width: 90px;
    height: auto;
    margin-bottom: 0.8rem;
    filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.25));
  }

  .nombre-ganador {
    font-size: 1.25rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 1.6rem 0.5rem 1.6rem;
    line-height: 1.2;
  }

  .escuela-ganador {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
    margin: 0 0 1rem 0;
  }

  .etiqueta-puesto {
    display: inline-block;
    background: #111;
    color: #fff;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }
  /* ==================================== */

  /*Prosigamos... */
  .puesto-1 {
    z-index: 1;
    margin-top: 0; /* Mero arriba */
  } /** Este wey por ejemplo está en la capa 1 */

  .puesto-2 {
    z-index: 2;
    margin-top: 70px;
    margin-right: -20px;
  } /** Y este otro wey en la capa 2 */

  .puesto-3 {
    z-index: 3;
    margin-top: 130px; /*Mero abajo, PD: te amo Abigail*/
    margin-left: -20px;
  }

  /* TABLA */
  .seccion-tabla {
    position: relative;
    z-index: 10;
    text-align: center;
    margin-top: 0.2rem;
  }

  .seccion-tabla h2 {
    font-size: 1.8rem;
    color: var(--negro);
    margin-bottom: 1.5rem;
    display: inline-block;
    background: var(--crema);
    padding: 0.5rem 2rem;
    border-radius: 30px;
    backdrop-filter: blur(5px);
  }

  .tabla-responsiva {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--gris);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0, 08);
  }

  .tabla-resultados {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .tabla-resultados th,
  .tabla-resultados td {
    padding: 1.2rem;
    border-bottom: 1px solid var(--gris);
  }

  .tabla-resultados th {
    background-color: var(--verde);
    color: #fff;
  }

  .tabla-resultados tbody tr:hover {
    background-color: var(--crema);
  }

  /* VISTA DE ESPERA */
  .proximamente {
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 5rem 2rem;
  }

  .icono-espera {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .titulo-espera {
    color: var(--negro);
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .texto-espera {
    font-size: 1.2rem;
    line-height: 1.6;
  }
  /* Ajustes para moviles que se veía qlero */
  @media (max-width: 768px) {
    .podio {
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .columna-podio {
      width: 100%;
      max-width: 320px;
      margin: 0 !important;
    }

    .pilar-fondo {
      height: 100%;
      mask-image: none;
      border-radius: 16px;
    }

    .seccion-tabla {
      margin-top: 2rem;
    }

    /* Orden natural vertical (1, 2, 3) */
    .puesto-1 {
      order: 1;
    }
    .puesto-2 {
      order: 2;
    }
    .puesto-3 {
      order: 3;
    }

    .tabla-resultados th,
    .tabla-resultados td {
      padding: 0.8rem;
      font-size: 0.9rem;
    }
  }
</style>
